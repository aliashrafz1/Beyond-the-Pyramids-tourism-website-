<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Package Management | Beyond the Pyramids</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0">
    <link rel="stylesheet" href="/css/adminPackages.css">
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Agency Admin</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <span id="theme-icon-sun"  class="material-symbols-rounded">light_mode</span>
                <span id="theme-icon-moon" class="material-symbols-rounded" style="display:none">dark_mode</span>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li class="active"><a href="/admin/packages"><i class="fas fa-boxes-packing"></i> Package Management</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li><a href="/admin/users"><i class="fas fa-users-cog"></i> User Management</a></li>
                <li><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--gold-primary);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="top-bar-left">
                <h1>Package Inventory</h1>
                <p>Manage and organize tours, day trips, and premium week packages</p>
            </div>
            <div class="top-bar-right">
                <button class="btn-primary" id="createPackageBtn"><i class="fas fa-plus"></i> Create New Package</button>
            </div>
        </header>

        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-boxes-packing"></i></div>
                <div class="stat-info">
                    <h3>Total Packages</h3>
                    <div class="stat-value" id="totalPackages">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--color-success)"><i class="fas fa-check-circle"></i></div>
                <div class="stat-info">
                    <h3>Active Packages</h3>
                    <div class="stat-value" id="activePackages">0</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--gold-primary)"><i class="fas fa-star"></i></div>
                <div class="stat-info">
                    <h3>Most Popular</h3>
                    <div class="stat-value" id="mostPopular">--</div>
                </div>
            </div>
        </section>

        <div class="toolbar">
            <div class="toolbar-left">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search by name or location...">
                </div>
                <select id="typeFilter" class="select-modern">
                    <option value="all">All Types</option>
                    <option value="single">Single Locations</option>
                    <option value="day">Day Packages</option>
                    <option value="week">Week Packages</option>
                </select>
                <select id="statusFilter" class="select-modern">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>
        </div>

        <nav class="tab-navigation">
            <button class="tab-link active" data-type="all">All Inventory</button>
            <button class="tab-link" data-type="single">Single Locations</button>
            <button class="tab-link" data-type="day">Day Packages</button>
            <button class="tab-link" data-type="week">Week Packages</button>
        </nav>

        <section class="packages-grid" id="packagesContainer"></section>
    </main>
</div>

<div class="modal-overlay" id="selectTypeModal">
    <div class="modal-container" style="max-width:550px;">
        <div class="modal-header">
            <h3>Select Package Type</h3>
            <button class="modal-close" onclick="closeModal('selectTypeModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="type-options-container">
                <button class="type-btn" data-type="single"><i class="fas fa-map-marker-alt"></i><span>Single Location</span></button>
                <button class="type-btn" data-type="day"><i class="fas fa-sun"></i><span>Day Package</span></button>
                <button class="type-btn" data-type="week"><i class="fas fa-calendar-week"></i><span>Week Package</span></button>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="packageModal">
    <div class="modal-container">
        <div class="modal-header">
            <h3 id="modalTitle">Create Package</h3>
            <button class="modal-close" onclick="closeModal('packageModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="packageForm" class="form-grid">
                <input type="hidden" id="packageId">

                <div class="form-group full-width">
                    <label>Package Image</label>
                    <div id="imagePreviewArea" onclick="document.getElementById('pkgImageFile').click()" style="width:100%;height:160px;border:2px dashed var(--color-border);border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--color-surface-alt);cursor:pointer;margin-bottom:8px;transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--gold-primary)'" onmouseout="this.style.borderColor='var(--color-border)'">
                        <img id="imagePreview" src="" alt="Preview" style="display:none;width:100%;height:100%;object-fit:cover;">
                        <div id="imageUploadPlaceholder" style="text-align:center;color:var(--color-text-muted);pointer-events:none;">
                            <i class="fas fa-image" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
                            <span style="font-size:0.85rem;">Click to choose image</span>
                        </div>
                    </div>
                    <input type="file" id="pkgImageFile" accept="image/jpeg,image/png,image/webp" style="display:none;">
                </div>

                <div class="form-group full-width">
                    <label>Package Name *</label>
                    <input type="text" id="pkgName" required placeholder="e.g., Majestic Luxor Private Tour">
                </div>
                <div class="form-group">
                    <label>Package Type</label>
                    <input type="text" id="pkgType" readonly disabled style="background:#f9f9f9;color:var(--gold-primary);font-weight:700;">
                </div>
                <div class="form-group">
                    <label>City *</label>
                    <select id="pkgCity" required>
                        <option value="">Select City</option>
                        <option value="Cairo">Cairo</option>
                        <option value="Giza">Giza</option>
                        <option value="Luxor">Luxor</option>
                        <option value="Aswan">Aswan</option>
                        <option value="Alexandria">Alexandria</option>
                        <option value="Hurghada">Hurghada</option>
                        <option value="Sharm El Sheikh">Sharm El Sheikh</option>
                        <option value="Dahab">Dahab</option>
                        <option value="Siwa">Siwa</option>
                        <option value="Fayoum">Fayoum</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select id="pkgStatus">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label>Description</label>
                    <textarea id="pkgDescription" rows="3" placeholder="Describe the traveler experience in 1–2 compelling sentences..."></textarea>
                </div>

                <div class="form-group full-width">
                    <fieldset>
                        <legend>Pricing</legend>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Standard Tier Price (EGP) *</label>
                                <input type="number" id="pkgDiscountedPrice" placeholder="e.g. 8500" min="1">
                                <small style="color:var(--color-text-muted);font-size:0.75rem;">Group tour, shared transport, standard inclusions</small>
                            </div>
                            <div class="form-group">
                                <label>Deluxe Tier Price (EGP) *</label>
                                <input type="number" id="pkgPrice" required placeholder="e.g. 16500" min="1">
                                <small style="color:var(--color-text-muted);font-size:0.75rem;">Private guide, premium transport, luxury inclusions</small>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <div class="form-group full-width">
                    <fieldset>
                        <legend>Audience &amp; Services</legend>
                        <div class="form-grid">
                            <div class="form-group" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:end;">
                                <div>
                                    <label>Min Group</label>
                                    <input type="number" id="minGroup" placeholder="1" min="1">
                                </div>
                                <div>
                                    <label>Max Group</label>
                                    <input type="number" id="maxGroup" placeholder="12" min="1">
                                </div>
                            </div>
                            <div class="form-group full-width">
                                <label>Standard Inclusions <small style="font-weight:400;color:var(--color-text-muted)">(comma-separated — shown as highlight pills)</small></label>
                                <input type="text" id="includedServices" placeholder="Egyptologist guide, A/C transport, Entry fees, Lunch">
                            </div>
                            <div class="form-group full-width">
                                <label>Deluxe Tier Extras <small style="font-weight:400;color:var(--color-text-muted)">(pipe-separated | — listed in the Deluxe panel)</small></label>
                                <textarea id="deluxeExtras" rows="3" placeholder="Private A/C car|Personal Egyptologist|VIP fast-track entry|Gourmet lunch"></textarea>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <div class="form-group full-width" id="singleFields" style="display:none;">
                    <fieldset>
                        <legend>Location Details</legend>
                        <div class="form-grid">
                            <div class="form-group"><label>Opening Hours</label><input type="text" id="openingHours" placeholder="8:00 AM – 5:00 PM"></div>
                            <div class="form-group"><label>Closing Days</label><input type="text" id="closingDays" placeholder="None — open daily"></div>
                            <div class="form-group"><label>Recommended Duration (hrs)</label><input type="number" id="recommendedDuration" placeholder="3" min="0.5" step="0.5"></div>
                            <div class="form-group"><label>Guided Tour</label><select id="guidedTour"><option value="yes">Yes</option><option value="no">No</option></select></div>
                        </div>
                        <div style="margin-top:16px;">
                            <label class="form-group" style="display:block;font-size:0.85rem;font-weight:700;margin-bottom:8px;">Visit Schedule</label>
                            <p class="builder-hint">Add each stop with its time, activity name, and an optional short description.</p>
                            <div id="singleItinBuilder" class="itin-builder"></div>
                            <button type="button" class="add-row-btn" onclick="addItinRow('singleItinBuilder')"><i class="fas fa-plus"></i> Add Stop</button>
                        </div>
                    </fieldset>
                </div>

                <div class="form-group full-width" id="dayFields" style="display:none;">
                    <fieldset>
                        <legend>Day Tour Details</legend>
                        <div class="form-grid">
                            <div class="form-group"><label>Opening / Departure Time</label><input type="text" id="openingHoursDay" placeholder="Departs 08:00 daily"></div>
                            <div class="form-group"><label>Closed / Reduced Days</label><input type="text" id="closingDaysDay" placeholder="None"></div>
                            <div class="form-group"><label>Total Duration (hrs)</label><input type="number" id="dayDuration" placeholder="10" min="1"></div>
                        </div>
                        <div style="margin-top:16px;">
                            <label style="display:block;font-size:0.85rem;font-weight:700;margin-bottom:8px;">Day Itinerary</label>
                            <p class="builder-hint">Add each stop: time (e.g. 09:00), activity name, and an optional brief description.</p>
                            <div id="dayItinBuilder" class="itin-builder"></div>
                            <button type="button" class="add-row-btn" onclick="addItinRow('dayItinBuilder')"><i class="fas fa-plus"></i> Add Stop</button>
                        </div>
                    </fieldset>
                </div>

                <div class="form-group full-width" id="weekFields" style="display:none;">
                    <fieldset>
                        <legend>Week Package Details</legend>
                        <div class="form-grid">
                            <div class="form-group"><label>Duration (Days)</label><input type="number" id="weekDuration" placeholder="7" min="1"></div>
                            <div class="form-group"><label>Nights</label><input type="number" id="nights" placeholder="6" min="1"></div>
                            <div class="form-group"><label>Accommodation</label><select id="accommodationIncluded"><option value="yes">Included</option><option value="no">Not Included</option></select></div>
                            <div class="form-group"><label>Hotel Tier / Name</label><input type="text" id="hotelName" placeholder="e.g., 4-star · Marriott Mena House"></div>
                        </div>
                        <div style="margin-top:16px;">
                            <label style="display:block;font-size:0.85rem;font-weight:700;margin-bottom:8px;">Day-by-Day Itinerary</label>
                            <p class="builder-hint">Add each day: day number, title, full description, and meals included.</p>
                            <div id="weekDailyBuilder" class="itin-builder"></div>
                            <button type="button" class="add-row-btn" onclick="addDailyRow('weekDailyBuilder')"><i class="fas fa-plus"></i> Add Day</button>
                        </div>
                    </fieldset>
                </div>

                <div class="form-group full-width" id="formError" style="display:none;">
                    <p style="color:var(--color-danger);font-weight:600;" id="formErrorMsg"></p>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn-ghost" onclick="closeModal('packageModal')">Cancel</button>
            <button class="btn-primary" id="savePackageBtn">Save Changes</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="deleteModal">
    <div class="modal-container" style="max-width:400px;text-align:center;">
        <div class="modal-header">
            <h3>Confirm Delete</h3>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to remove <strong id="deletePackageName" style="color:var(--color-danger)"></strong>?</p>
            <p style="font-size:0.8rem;color:var(--color-text-muted);margin-top:10px;">This action cannot be undone and will remove all related booking availability.</p>
        </div>
        <div class="modal-footer" style="justify-content:center;">
            <button class="btn-ghost" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-primary" style="background:var(--color-danger)" id="confirmDeleteBtn">Delete Forever</button>
        </div>
    </div>
</div>

<script>
    const SERVER_DATA = {
        user: <%- JSON.stringify(user) %>,
        packages: <%- JSON.stringify(packages.map(p => ({
            id: String(p._id),
            _id: String(p._id),
            type: p.type,
            name: p.name,
            city: p.city || '',
            description: p.description || '',
            image: p.image || '',
            price: p.price || 0,
            discountedPrice: p.discountedPrice || null,
            status: p.status || 'active',
            rating: p.rating || 4.5,
            reviews: p.reviewCount || 0,

            minGroup: p.minGroup || 1,
            maxGroup: p.maxGroup || 15,
            includedServices: p.includedServices || '',
            deluxeExtras: p.deluxeExtras || '',
            openingHours: p.openingHours || '',
            closingDays: p.closingDays || '',
            recommendedDuration: p.recommendedDuration || '',
            guidedTour: p.guidedTour || 'yes',
            duration: p.duration || '',
            itinerary: p.itinerary || [],
            durationDays: p.durationDays || '',
            nights: p.nights || '',
            accommodationIncluded: p.accommodationIncluded || 'yes',
            hotelName: p.hotelName || '',
            dailyItinerary: p.dailyItinerary || [],
        }))) %>
    };
    window.SERVER_DATA = SERVER_DATA;
    window.SERVER_USER = SERVER_DATA.user;

</script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
<script src="/js/adminPackages.js"></script>
</body>
</html>
