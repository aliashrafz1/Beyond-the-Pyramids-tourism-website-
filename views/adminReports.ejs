<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports &amp; Analytics - Beyond the Pyramids</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0">
    <link rel="stylesheet" href="/css/adminReports.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Agency Admin</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <span id="theme-icon-sun"  class="material-symbols-rounded">light_mode</span>
                <span id="theme-icon-moon" class="material-symbols-rounded" style="display:none">dark_mode</span>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li><a href="/admin/packages"><i class="fas fa-cubes"></i> Package Management</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li><a href="/admin/users"><i class="fas fa-user-shield"></i> User Management</a></li>
                <li class="active"><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--gold-primary);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div>
                <h1>Reports &amp; Analytics</h1>
                <p>Platform-wide performance across users, bookings, packages, and reviews</p>
            </div>
        </header>

        <section class="kpi-row" id="kpiRow"></section>

        <div class="report-section card">
            <div class="section-header">
                <h2><i class="fas fa-boxes-packing"></i> Package Bookings</h2>
                <div class="section-filters">
                    <select id="packageStatusFilter" class="select-modern">
                        <option value="all">All Statuses</option>
                        <option value="confirmed">Confirmed</option>
                        <option value="checked-in">Checked-In</option>
                        <option value="checked-out">Checked-Out</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                    <div class="filter-group"><label>From:</label><input type="date" id="pkgStartDate"></div>
                    <div class="filter-group"><label>To:</label><input type="date" id="pkgEndDate"></div>
                    <button class="btn-primary" id="applyPkgFilter">Apply</button>
                    <button class="btn-ghost" id="resetPkgFilter">Reset</button>
                </div>
            </div>
            <div class="section-content">
                <div class="stats-grid" id="pkgStatsGrid"></div>
                <div class="two-col">
                    <div class="chart-container"><canvas id="pkgStatusChart"></canvas></div>
                    <div class="chart-container"><canvas id="pkgRevenueChart"></canvas></div>
                </div>
                <div class="highlight-grid" id="pkgHighlights"></div>
            </div>
        </div>

        <div class="report-section card">
            <div class="section-header">
                <h2><i class="fas fa-star"></i> Platform Feedback</h2>
                <div class="section-filters">
                    <input type="date" id="reviewStartDate">
                    <input type="date" id="reviewEndDate">
                    <button class="btn-primary apply-review-btn">Apply</button>
                    <button class="btn-ghost reset-review-btn">Reset</button>
                </div>
            </div>
            <div class="section-content">
                <div class="rating-layout">
                    <div class="rating-main-card">
                        <h3>Overall Rating</h3>
                        <div id="overallRating" class="big-rating">0</div>
                        <div class="stars-modern" id="starDisplay"></div>
                        <p id="reviewCount" style="color:var(--color-text-muted);font-size:0.85rem;margin-top:8px;"></p>
                    </div>
                    <div class="reviews-feed-card">
                        <h3>Recent Reviews</h3>
                        <div id="reviewsList" class="custom-scroll"></div>
                    </div>
                    <div class="chart-container-sidebar"><canvas id="ratingChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="report-section card">
            <div class="section-header">
                <h2><i class="fas fa-users"></i> User Accounts</h2>
                <div class="section-filters">
                    <select id="userRoleFilter" class="select-modern">
                        <option value="all">All Roles</option>
                        <option value="admin">Staff / Admins</option>
                        <option value="user">Tourists</option>
                    </select>
                    <select id="userStatusFilter" class="select-modern">
                        <option value="all">All Status</option>
                        <option value="active">Active</option>
                        <option value="suspended">Suspended</option>
                    </select>
                </div>
            </div>
            <div class="section-content">
                <div class="stats-grid" id="userStatsGrid"></div>
                <div class="chart-container large"><canvas id="usersChart"></canvas></div>
                <div class="table-container" style="margin-top:24px;">
                    <table>
                        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Nationality</th><th>Status</th><th>Join Date</th></tr></thead>
                        <tbody id="usersTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>
</div>

<script>
    const SERVER_DATA = {
        user: <%- JSON.stringify(user) %>,
        allUsers: <%- JSON.stringify(allUsers) %>,
        allBookings: <%- JSON.stringify(allBookings) %>,
        allReviews: <%- JSON.stringify(allReviews) %>,
        totalRevenue: <%= totalRevenue %>,
        openTickets: <%= openTickets %>
    };
    window.SERVER_USER = SERVER_DATA.user;

    const GOLD = 'rgba(197,160,89,0.85)', GOLD_B = '#C5A059';
    const GREEN = 'rgba(39,174,96,0.8)', GREEN_B = '#27AE60';
    const RED = 'rgba(220,53,69,0.75)', RED_B = '#dc3545';
    const BLUE = 'rgba(41,128,185,0.8)', BLUE_B = '#2980B9';
    const MUTED = 'rgba(150,150,150,0.6)';

    let usersChart, pkgStatusChart, pkgRevenueChart, ratingChart;

    function destroyChart(c) { if (c) { try { c.destroy(); } catch(e){} } }

    function statCard(label, value, icon, colorStyle) {
        return `<div class="stat-card">
            ${icon ? `<div class="stat-icon" style="${colorStyle}"><i class="${icon}"></i></div>` : ''}
            <div class="stat-info"><h3>${label}</h3><div class="stat-value">${value}</div></div>
        </div>`;
    }

    function badgePill(text, type) {
        const map = { confirmed:'badge-confirmed','checked-in':'badge-checkin','checked-out':'badge-checkout',cancelled:'badge-cancelled',active:'badge-active',suspended:'badge-suspended',admin:'badge-admin',user:'badge-user' };
        return `<span class="${map[type] || 'badge-role'}">${text}</span>`;
    }

    function renderKPIRow() {
        const users    = SERVER_DATA.allUsers;
        const bookings = SERVER_DATA.allBookings.map(b => ({
            ...b, computedStatus: computeBookingStatus(b.status, b.date)
        }));
        const confirmed = bookings.filter(b => b.computedStatus !== 'cancelled').length;
        const cancelled = bookings.filter(b => b.computedStatus === 'cancelled').length;

        document.getElementById('kpiRow').innerHTML = `
            ${statCard('Total Users', users.length, 'fas fa-users', 'color:#C5A059;background:rgba(197,160,89,0.1)')}
            ${statCard('Active Pkg Bookings', confirmed, 'fas fa-calendar-check', 'color:#27AE60;background:rgba(39,174,96,0.1)')}
            ${statCard('Cancelled Packages', cancelled, 'fas fa-ban', 'color:#dc3545;background:rgba(220,53,69,0.1)')}
        `;
    }

    function renderUsers() {
        const roleFilter   = document.getElementById('userRoleFilter').value;
        const statusFilter = document.getElementById('userStatusFilter').value;
        const all   = SERVER_DATA.allUsers;
        let users = all.filter(u =>
            (roleFilter === 'all' || u.role === roleFilter) &&
            (statusFilter === 'all' || u.status === statusFilter)
        );

        const adminCount     = all.filter(u => u.role === 'admin').length;
        const userCount      = all.filter(u => u.role === 'user').length;
        const suspendedCount = all.filter(u => u.status === 'suspended').length;

        document.getElementById('userStatsGrid').innerHTML = `
            ${statCard('Total Accounts', all.length, 'fas fa-users', 'color:#C5A059;background:rgba(197,160,89,0.1)')}
            ${statCard('Staff / Admins', adminCount, 'fas fa-user-shield', 'color:#C5A059;background:rgba(197,160,89,0.1)')}
            ${statCard('Tourists', userCount, 'fas fa-user', 'color:#27AE60;background:rgba(39,174,96,0.1)')}
            ${statCard('Suspended', suspendedCount, 'fas fa-user-slash', 'color:#dc3545;background:rgba(220,53,69,0.1)')}
        `;

        destroyChart(usersChart);
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const adminCounts = new Array(12).fill(0);
        const userCounts  = new Array(12).fill(0);
        all.forEach(u => {
            const m = u.joinDate ? new Date(u.joinDate).getMonth() : -1;
            if (m < 0) return;
            if (u.role === 'admin') adminCounts[m]++; else userCounts[m]++;
        });
        const ctx = document.getElementById('usersChart').getContext('2d');
        usersChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [
                    { label: 'Staff/Admins', data: adminCounts, backgroundColor: GOLD, borderColor: GOLD_B, borderWidth: 1, borderRadius: 4 },
                    { label: 'Tourists', data: userCounts, backgroundColor: GREEN, borderColor: GREEN_B, borderWidth: 1, borderRadius: 4 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true, stacked: true, ticks: { stepSize: 2 } }, x: { stacked: true } } }
        });

        const tbody = document.getElementById('usersTableBody');
        tbody.innerHTML = users.length === 0
            ? '<tr><td colspan="6" style="text-align:center;padding:30px;color:var(--color-text-muted);">No accounts match filter.</td></tr>'
            : users.map(u => `<tr>
                <td style="font-weight:600;">${u.name}</td>
                <td>${u.email}</td>
                <td>${badgePill(u.fullRole || (u.role === 'admin' ? 'Admin' : 'Tourist'), u.role)}</td>
                <td>${u.nationality || '—'}</td>
                <td>${badgePill(u.status, u.status)}</td>
                <td>${u.joinDate || '—'}</td>
            </tr>`).join('');
    }

    function computeBookingStatus(dbStatus, dateStr) {
        if (dbStatus === 'cancelled') return 'cancelled';
        if (!dateStr || dateStr.includes(' to ')) return dbStatus;
        const today = new Date(); today.setHours(0,0,0,0);
        const d = new Date(dateStr); d.setHours(0,0,0,0);
        if (isNaN(d)) return dbStatus;
        if (today < d)  return 'confirmed';
        if (today.getTime() === d.getTime()) return 'checked-in';
        return 'checked-out';
    }

    function renderPackages() {
        const statusFilter = document.getElementById('packageStatusFilter').value;
        const startDate    = document.getElementById('pkgStartDate').value;
        const endDate      = document.getElementById('pkgEndDate').value;

        let bookings = SERVER_DATA.allBookings.map(b => ({
            ...b,
            computedStatus: computeBookingStatus(b.status, b.date)
        })).filter(b => {
            const matchStatus = statusFilter === 'all' || b.computedStatus === statusFilter;
            const matchStart  = !startDate || (b.date || b.createdAt || '') >= startDate;
            const matchEnd    = !endDate   || (b.date || b.createdAt || '') <= endDate;
            return matchStatus && matchStart && matchEnd;
        });

        const counts = { confirmed: 0, 'checked-in': 0, 'checked-out': 0, cancelled: 0 };
        bookings.forEach(b => { if (counts[b.computedStatus] !== undefined) counts[b.computedStatus]++; });

        const pkgCount = {};
        bookings.forEach(b => {
            const k = b.packageName || 'Unknown';
            pkgCount[k] = (pkgCount[k] || 0) + 1;
        });
        const sorted = Object.entries(pkgCount).sort((a, b) => b[1] - a[1]);

        document.getElementById('pkgStatsGrid').innerHTML = `
            ${statCard('Total Bookings', bookings.length, 'fas fa-ticket-alt', 'color:#C5A059;background:rgba(197,160,89,0.1)')}
            ${statCard('Confirmed', counts['confirmed'], 'fas fa-check-circle', 'color:#27AE60;background:rgba(39,174,96,0.1)')}
            ${statCard('Checked-In', counts['checked-in'], 'fas fa-door-open', 'color:#2980B9;background:rgba(41,128,185,0.1)')}
            ${statCard('Checked-Out', counts['checked-out'], 'fas fa-door-closed', 'color:#8e44ad;background:rgba(142,68,173,0.1)')}
            ${statCard('Cancelled', counts['cancelled'], 'fas fa-ban', 'color:#dc3545;background:rgba(220,53,69,0.1)')}
        `;

        destroyChart(pkgStatusChart);
        pkgStatusChart = new Chart(document.getElementById('pkgStatusChart').getContext('2d'), {
            type: 'doughnut',
            data: { labels: ['Confirmed','Checked-In','Checked-Out','Cancelled'],
                    datasets: [{ data: [counts['confirmed'], counts['checked-in'], counts['checked-out'], counts['cancelled']], backgroundColor: [GREEN, BLUE, GOLD, RED], borderWidth: 2 }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom' } } }
        });

        destroyChart(pkgRevenueChart);
        pkgRevenueChart = new Chart(document.getElementById('pkgRevenueChart').getContext('2d'), {
            type: 'bar',
            data: { labels: sorted.map(e => e[0]).slice(0, 8), datasets: [{ label: 'Bookings per Package', data: sorted.map(e => e[1]).slice(0, 8), backgroundColor: GOLD, borderColor: GOLD_B, borderWidth: 1, borderRadius: 6 }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true } } }
        });

        document.getElementById('pkgHighlights').innerHTML = sorted.length > 0 ? `
            <div class="highlight-card most-popular">
                <i class="fas fa-fire"></i>
                <div><h4>Most Popular Package</h4><p>${sorted[0][0]} — ${sorted[0][1]} booking${sorted[0][1] !== 1 ? 's' : ''}</p></div>
            </div>
            ${sorted.length > 1 ? `<div class="highlight-card least-popular">
                <i class="fas fa-snowflake"></i>
                <div><h4>Least Popular Package</h4><p>${sorted[sorted.length-1][0]} — ${sorted[sorted.length-1][1]} booking${sorted[sorted.length-1][1] !== 1 ? 's' : ''}</p></div>
            </div>` : ''}
        ` : '';
    }

    function renderReviews() {
        const sd = document.getElementById('reviewStartDate').value;
        const ed = document.getElementById('reviewEndDate').value;

        const filtered = SERVER_DATA.allReviews.filter(r =>
            (!sd || r.date >= sd) && (!ed || r.date <= ed)
        );

        const avg = filtered.length > 0 ? filtered.reduce((s, r) => s + r.rating, 0) / filtered.length : 0;
        document.getElementById('overallRating').textContent = avg.toFixed(1);
        document.getElementById('reviewCount').textContent = `Based on ${filtered.length} review${filtered.length !== 1 ? 's' : ''}`;

        const full = Math.floor(avg), half = avg % 1 >= 0.5;
        let stars = '★'.repeat(full);
        if (half) stars += '½';
        stars += '☆'.repeat(5 - full - (half ? 1 : 0));
        document.getElementById('starDisplay').innerHTML = stars;

        document.getElementById('reviewsList').innerHTML = filtered.length === 0
            ? '<div style="color:var(--color-text-muted);padding:20px;">No reviews in range.</div>'
            : filtered.map(r => `
                <div class="review-item" id="admin-review-${r.id}">
                    <div class="review-header">
                        <strong>${r.user}</strong>
                        <span style="color:#F1C40F;">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</span>
                        <span class="review-date">${r.date}</span>
                        <button onclick="deleteAdminReview('${r.id}')" style="margin-left:auto;background:none;border:none;color:#dc3545;cursor:pointer;font-size:0.8rem;"><i class="fas fa-trash"></i> Delete</button>
                    </div>
                    <p class="review-text">"${r.review}"</p>
                    ${r.photos && r.photos.length ? `
                    <div class="review-photos">
                        ${r.photos.slice(0, 4).map(p => `<a href="${p}" target="_blank" rel="noopener"><img src="${p}" alt="Review photo" class="review-photo-thumb" loading="lazy"></a>`).join('')}
                    </div>` : ''}
                </div>`).join('');

        const starCounts = [0,0,0,0,0];
        filtered.forEach(r => { if (r.rating >= 1 && r.rating <= 5) starCounts[r.rating-1]++; });

        destroyChart(ratingChart);
        ratingChart = new Chart(document.getElementById('ratingChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['1 ★','2 ★','3 ★','4 ★','5 ★'],
                datasets: [{ label: 'Reviews', data: starCounts, backgroundColor: [RED,'rgba(230,126,34,0.7)',MUTED,BLUE,GREEN], borderRadius: 6 }]
            },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });
    }

    async function deleteAdminReview(id) {
        if (!confirm('Delete this review?')) return;
        const res = await fetch('/api/reviews/' + id, { method: 'DELETE', credentials: 'include' });
        if (res.ok || res.status === 204) {
            SERVER_DATA.allReviews = SERVER_DATA.allReviews.filter(r => r.id !== id);
            renderReviews();
        }
    }

    function setDefaultDates() {
        const today = new Date();
        const sixAgo = new Date(); sixAgo.setMonth(sixAgo.getMonth() - 6);
        document.getElementById('pkgStartDate').value = '';
        document.getElementById('pkgEndDate').value   = '';
        document.getElementById('reviewStartDate').value = sixAgo.toISOString().split('T')[0];
        document.getElementById('reviewEndDate').value   = today.toISOString().split('T')[0];
    }

    document.addEventListener('DOMContentLoaded', () => {
        setDefaultDates();

        document.getElementById('userRoleFilter').addEventListener('change', renderUsers);
        document.getElementById('userStatusFilter').addEventListener('change', renderUsers);
        document.getElementById('packageStatusFilter').addEventListener('change', renderPackages);
        document.getElementById('applyPkgFilter').addEventListener('click', renderPackages);
        document.getElementById('resetPkgFilter').addEventListener('click', () => {
            setDefaultDates();
            document.getElementById('packageStatusFilter').value = 'all';
            renderPackages();
        });
        document.querySelector('.apply-review-btn').addEventListener('click', renderReviews);
        document.querySelector('.reset-review-btn').addEventListener('click', () => {
            const today = new Date(), sixAgo = new Date();
            sixAgo.setMonth(sixAgo.getMonth() - 6);
            document.getElementById('reviewStartDate').value = sixAgo.toISOString().split('T')[0];
            document.getElementById('reviewEndDate').value   = today.toISOString().split('T')[0];
            renderReviews();
        });

        renderKPIRow();
        renderUsers();
        renderPackages();
        renderReviews();
    });

</script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
</body>
</html>
