<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beyond the Pyramids - Login</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="auth-container">
        <div class="neon-border-wrap">
            <main class="layout">
                <div class="image-panel reveal-item">
                    <div class="image-inner">
                        <img src="/images/laytoutImageLogin.jpeg" alt="Pyramids of Giza at golden hour" class="backdrop-img">
                        <div class="overlay-text">
                            <span class="tag">Welcome Back</span>
                            <h2>Beyond the Pyramids</h2>
                            <p>Sign in to resume your journey through the timeless wonders of the ancient world.</p>
                        </div>
                    </div>
                </div>

                <div class="form-panel">
                    <div class="form-header reveal-item">
                        <img src="/images/WebsiteBanner.png" alt="Beyond the Pyramids" class="logo">
                        <h1>Access Your Portal</h1>
                        <p>Enter your credentials to manage your itineraries and bookings.</p>
                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-banner" style="color:#e74c3c;background:#2d1010;padding:10px 16px;border-radius:6px;margin-bottom:16px;">
                        <%= error %>
                    </div>
                    <% } %>

                    <form id="login-form" class="editorial-form reveal-item">
                        <div class="field">
                            <label for="username">Email Address</label>
                            <input type="text" id="username" name="username" placeholder="name@egypt.com" autocomplete="off" required>
                        </div>

                        <div class="field">
                            <label for="password">Security Password</label>
                            <div class="pass-wrapper">
                                <input type="password" id="password" name="password" placeholder="••••••••" required>
                                <button type="button" class="password-toggle" id="togglePasswordBtn" aria-label="Show password">
                                    <i class="far fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div id="login-error" class="error-message" style="display:none;color:#e74c3c;margin-bottom:10px;"></div>

                        <div class="form-actions">
                            <button type="submit" class="submit-btn primary-btn">Sign In</button>
                        </div>
                    </form>

                    <div class="reg-prompt reveal-item">
                        <p>New explorer? <a href="/register">Start your journey</a></p>
                    </div>

                    <footer class="form-footer reveal-item">
                        <p>&copy; 2026 Beyond the Pyramids. All rights reserved.</p>
                    </footer>
                </div>
            </main>
        </div>
    </div>

    <script>
        const SERVER_USER = <%- JSON.stringify(user) %>;
    </script>
    <script src="/js/login.js"></script>
</body>
</html>
