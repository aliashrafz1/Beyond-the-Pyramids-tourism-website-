<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management | Beyond the Pyramids</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0">
    <link rel="stylesheet" href="/css/adminUsers.css">
</head>
<body>
<div class="dashboard-shell">

    <aside class="dashboard-sidebar">
        <div class="sidebar-header">
            <h2>Agency Admin</h2>
            <button id="admin-theme-toggle" class="admin-theme-btn" title="Switch to Light Mode">
                <span id="theme-icon-sun"  class="material-symbols-rounded">light_mode</span>
                <span id="theme-icon-moon" class="material-symbols-rounded" style="display:none">dark_mode</span>
            </button>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li><a href="/admin"><i class="fas fa-chart-line"></i> Overview</a></li>
                <li><a href="/admin/bookings"><i class="fas fa-calendar-check"></i> Booking Management</a></li>
                <li><a href="/admin/packages"><i class="fas fa-boxes-packing"></i> Package Management</a></li>
                <li><a href="/admin/contact"><i class="fas fa-headset"></i> Support Tickets</a></li>
                <li class="active"><a href="/admin/users"><i class="fas fa-users-cog"></i> User Management</a></li>
                <li><a href="/admin/reports"><i class="fas fa-file-invoice-dollar"></i> Reports &amp; Analytics</a></li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <div class="account-chip account-chip--sidebar">
                <div class="account-chip__avatar">
                    <% if (user.image) { %><img src="<%= user.image %>" alt="<%= user.name %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><% } else { %><i class="fas fa-user-circle" style="font-size:1.4rem;color:var(--gold-primary);"></i><% } %>
                </div>
                <div>
                    <span class="account-chip__label">Signed in as</span>
                    <strong class="account-chip__name"><%= user.name %></strong>
                </div>
            </div>
            <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="header-left">
                <h1>User Accounts</h1>
                <p>Manage all registered users and administrators</p>
            </div>
        </header>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-info"><h3>Total Accounts</h3><div class="stat-value" id="totalUsersCount">0</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--gold-primary);background:rgba(197,160,89,0.1);"><i class="fas fa-user-shield"></i></div>
                <div class="stat-info"><h3>Staff / Admins</h3><div class="stat-value" id="adminCount">0</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:var(--color-success);background:rgba(39,174,96,0.1);"><i class="fas fa-user"></i></div>
                <div class="stat-info"><h3>Tourists</h3><div class="stat-value" id="userCount">0</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="color:#e05260;background:rgba(220,53,69,0.1);"><i class="fas fa-user-slash"></i></div>
                <div class="stat-info"><h3>Suspended</h3><div class="stat-value" id="suspendedCount">0</div></div>
            </div>
        </div>

        <div class="toolbar">
            <div class="toolbar-left">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search by name or email...">
                </div>
                <select id="roleFilter" class="select-modern">
                    <option value="all">All Roles</option>
                    <option value="admin">Staff / Admin</option>
                    <option value="user">Tourist</option>
                </select>
                <select id="statusFilter" class="select-modern">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="suspended">Suspended</option>
                </select>
            </div>
        </div>

        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Nationality</th>
                        <th>Phone</th>
                        <th>Join Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="usersList"></tbody>
            </table>
            <div id="emptyState" class="empty-state" style="display:none;">
                <i class="fas fa-user-slash"></i>
                <p>No matching accounts found</p>
            </div>
        </div>
    </main>
</div>

<div id="userModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h3 id="modalTitle">Edit User</h3>
            <button class="modal-close" id="closeModalBtn">&times;</button>
        </div>
        <div class="modal-body">
            <form id="userForm" class="form-grid">
                <input type="hidden" id="userId">
                <div class="form-group full-width" style="display:flex;align-items:center;gap:1rem;margin-bottom:0.5rem;">
                    <div id="modalAvatarWrap" style="width:72px;height:72px;border-radius:50%;overflow:hidden;border:2px solid var(--gold-primary);flex-shrink:0;background:rgba(197,160,89,0.1);display:flex;align-items:center;justify-content:center;">
                        <img id="modalAvatarImg" src="" style="width:100%;height:100%;object-fit:cover;display:none;">
                        <i id="modalAvatarIcon" class="fas fa-user" style="font-size:2rem;color:var(--gold-primary);"></i>
                    </div>
                    <div>
                        <label style="display:block;margin-bottom:0.4rem;">Profile Photo</label>
                        <input type="file" id="modalPhotoInput" accept="image/*" style="display:none;">
                        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                            <button type="button" id="modalUploadBtn" class="btn btn--outline btn--small"><i class="fas fa-camera"></i> Change Photo</button>
                            <button type="button" id="modalRemovePhotoBtn" class="btn btn--outline btn--small" style="display:none;color:var(--color-danger);border-color:var(--color-danger);"><i class="fas fa-trash"></i> Remove Photo</button>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="userName" placeholder="e.g. Sarah Ahmed">
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="userEmail" placeholder="email@example.com">
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" id="userPhone" placeholder="+20 100 000 0000">
                </div>
                <div class="form-group">
                    <label>Nationality</label>
                    <input type="text" id="userNationality" placeholder="e.g. Egypt">
                </div>
                <div class="form-group">
                    <label>Role</label>
                    <select id="userRole">
                        <option value="Tourist">Tourist</option>
                        <option value="Admin">Admin</option>

                    </select>
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select id="userStatus">
                        <option value="active">Active</option>
                        <option value="suspended">Suspended</option>
                    </select>
                </div>
                <div class="form-group full-width" id="formError" style="display:none;">
                    <p style="color:var(--color-danger);font-weight:600;" id="formErrorMsg"></p>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button id="cancelModalBtn" class="btn-ghost">Cancel</button>
            <button id="saveUserBtn" class="btn-primary">Save Account</button>
        </div>
    </div>
</div>

<div id="deleteModal" class="modal-overlay">
    <div class="modal-container" style="max-width:420px;text-align:center;">
        <div class="modal-header">
            <h3>Delete Account</h3>
        </div>
        <div class="modal-body">
            <div style="font-size:3rem;color:var(--color-danger);margin-bottom:20px;"><i class="fas fa-exclamation-triangle"></i></div>
            <p>Are you sure you want to permanently delete <strong id="deleteUserName" style="color:var(--color-danger);"></strong>?</p>
            <p style="color:var(--color-text-muted);font-size:0.85rem;margin-top:10px;">This action cannot be undone. All their booking history will remain in the system.</p>
        </div>
        <div class="modal-footer" style="justify-content:center;">
            <button class="btn-ghost" id="cancelDeleteBtn">Cancel</button>
            <button class="btn-primary" style="background:var(--color-danger);" id="confirmDeleteBtn">Delete Account</button>
        </div>
    </div>
</div>

<script>
    function getRoleCategory(role) {
        return role === 'Tourist' ? 'user' : 'admin';
    }

    const SERVER_DATA = {
        user: <%- JSON.stringify(user) %>,
        users: <%- JSON.stringify(users.map(u => ({
            id: String(u._id),
            _id: String(u._id),
            name: u.name || '',
            email: u.email || '',
            phone: u.phone || '',
            nationality: u.nationality || '',
            role: u.role || 'Tourist',
            status: u.status || 'active',
            image: u.image || '',
            joinDate: u.createdAt ? new Date(u.createdAt).toISOString().split('T')[0] : '',
        }))) %>
    };
    window.SERVER_USER = SERVER_DATA.user;

    let users = SERVER_DATA.users;
    let editingId = null;
    let deletingId = null;

    const CURRENT_USER_ID = SERVER_DATA.user._id || SERVER_DATA.user.id;

    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    function updateStats() {
        document.getElementById('totalUsersCount').textContent = users.length;
        document.getElementById('adminCount').textContent      = users.filter(u => getRoleCategory(u.role) === 'admin').length;
        document.getElementById('userCount').textContent       = users.filter(u => getRoleCategory(u.role) === 'user').length;
        document.getElementById('suspendedCount').textContent  = users.filter(u => u.status === 'suspended').length;
    }

    function displayUsers() {
        const search       = document.getElementById('searchInput').value.toLowerCase();
        const roleFilter   = document.getElementById('roleFilter').value;
        const statusFilter = document.getElementById('statusFilter').value;

        const filtered = users.filter(u =>
            (search === '' || (u.name || '').toLowerCase().includes(search) || (u.email || '').toLowerCase().includes(search)) &&
            (roleFilter === 'all' || getRoleCategory(u.role) === roleFilter) &&
            (statusFilter === 'all' || (u.status || 'active') === statusFilter)
        );

        const tbody     = document.getElementById('usersList');
        const emptyState = document.getElementById('emptyState');

        if (filtered.length === 0) { tbody.innerHTML = ''; emptyState.style.display = 'flex'; return; }
        emptyState.style.display = 'none';

        tbody.innerHTML = filtered.map(u => {
            const roleCategory = getRoleCategory(u.role);
            const roleLabel    = roleCategory === 'admin'
                ? `<i class="fas fa-user-shield"></i> ${u.role}`
                : `<i class="fas fa-user"></i> Tourist`;
            const roleClass    = roleCategory === 'admin' ? 'badge-admin' : 'badge-user';
            const statusBadge  = (u.status || 'active') === 'active'
                ? '<span class="badge-active">Active</span>'
                : '<span class="badge-suspended">Suspended</span>';

            const name         = u.name || u.email?.split('@')[0] || 'Unknown';
            const isMe         = u.id === CURRENT_USER_ID;
            const isOtherAdmin = getRoleCategory(u.role) === 'admin' && !isMe;
            const avatarHtml   = u.image ? `<img src="${u.image}" alt="${name}" class="user-avatar-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">` : '';
            const avatarFallback = `<div class="user-avatar-fallback" ${u.image ? 'style="display:none"' : ''}>${name.charAt(0).toUpperCase()}</div>`;

            return `
            <tr>
                <td>
                    <div class="user-cell">
                        <div class="user-avatar">${avatarHtml}${avatarFallback}</div>
                        <div><div class="user-name">${name}</div><div class="user-id">${u.id}</div></div>
                    </div>
                </td>
                <td>${u.email}</td>
                <td><span class="badge-role ${roleClass}">${roleLabel}</span></td>
                <td>${u.nationality || '—'}</td>
                <td>${u.phone || '—'}</td>
                <td>${u.joinDate || '—'}</td>
                <td>${statusBadge}</td>
                <td>
                    <div class="actions-cell">
                        <button class="btn-action-edit" onclick="openEditModal('${u.id}')" ${isOtherAdmin ? 'disabled title="Cannot edit another admin\'s account"' : 'title="Edit"'}><i class="fas fa-edit"></i></button>
                        <button class="btn-action-delete" onclick="openDeleteModal('${u.id}', '${name.replace(/'/g,"\\'")}')${isMe ? ' disabled title="Cannot delete yourself"' : ''}" ${isMe ? 'disabled' : ''} title="Delete"><i class="fas fa-trash"></i></button>
                    </div>
                </td>
            </tr>`;
        }).join('');
    }

    let pendingPhotoBase64 = null;
    let pendingPhotoRemoved = false;

    window.openEditModal = function(id) {
        const u = users.find(x => x.id === id);
        if (!u) return;
        editingId = id;
        pendingPhotoBase64   = null;
        pendingPhotoRemoved  = false;
        document.getElementById('modalTitle').textContent = 'Edit User';
        document.getElementById('userId').value          = u.id;
        document.getElementById('userName').value        = u.name || '';
        document.getElementById('userEmail').value       = u.email || '';
        document.getElementById('userPhone').value       = u.phone || '';
        document.getElementById('userNationality').value = u.nationality || '';
        document.getElementById('userRole').value        = u.role || 'Tourist';
        document.getElementById('userStatus').value      = u.status || 'active';
        document.getElementById('formError').style.display = 'none';
        document.getElementById('modalPhotoInput').value = '';

        const imgEl       = document.getElementById('modalAvatarImg');
        const iconEl      = document.getElementById('modalAvatarIcon');
        const removePhBtn = document.getElementById('modalRemovePhotoBtn');
        if (u.image) {
            imgEl.src = u.image; imgEl.style.display = 'block'; iconEl.style.display = 'none';
            removePhBtn.style.display = 'inline-flex';
        } else {
            imgEl.style.display = 'none'; iconEl.style.display = 'block';
            removePhBtn.style.display = 'none';
        }
        openModal('userModal');
    };

    document.getElementById('modalUploadBtn').addEventListener('click', () => {
        document.getElementById('modalPhotoInput').click();
    });

    document.getElementById('modalRemovePhotoBtn').addEventListener('click', () => {
        pendingPhotoBase64  = null;
        pendingPhotoRemoved = true;
        const imgEl  = document.getElementById('modalAvatarImg');
        const iconEl = document.getElementById('modalAvatarIcon');
        imgEl.src = ''; imgEl.style.display = 'none'; iconEl.style.display = 'block';
        document.getElementById('modalRemovePhotoBtn').style.display = 'none';
        document.getElementById('modalPhotoInput').value = '';
    });

    document.getElementById('modalPhotoInput').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        pendingPhotoRemoved = false;
        const reader = new FileReader();
        reader.onload = (ev) => {
            pendingPhotoBase64 = ev.target.result;
            const imgEl  = document.getElementById('modalAvatarImg');
            const iconEl = document.getElementById('modalAvatarIcon');
            imgEl.src = pendingPhotoBase64; imgEl.style.display = 'block'; iconEl.style.display = 'none';
            document.getElementById('modalRemovePhotoBtn').style.display = 'inline-flex';
        };
        reader.readAsDataURL(file);
    });

    async function saveUser() {
        const id     = document.getElementById('userId').value;
        const role   = document.getElementById('userRole').value;
        const status = document.getElementById('userStatus').value;
        const name   = document.getElementById('userName').value.trim();
        const phone  = document.getElementById('userPhone').value.trim();
        const nationality = document.getElementById('userNationality').value.trim();

        const errDiv = document.getElementById('formError');
        const errMsg = document.getElementById('formErrorMsg');

        if (!name || name.length < 2) { errMsg.textContent = 'Name must be at least 2 characters.'; errDiv.style.display = 'block'; return; }

        const saveBtn = document.getElementById('saveUserBtn');
        saveBtn.textContent = 'Saving...'; saveBtn.disabled = true;
        errDiv.style.display = 'none';

        try {
            const origUser = users.find(u => u.id === id);

            const profileBody = { name, phone, nationality };
            if (pendingPhotoRemoved)      profileBody.removeImage = true;
            else if (pendingPhotoBase64)  profileBody.image = pendingPhotoBase64;
            const profileRes = await fetch('/api/users/' + id + '/profile', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify(profileBody)
            });
            if (!profileRes.ok) { const d = await profileRes.json(); throw new Error(d.message || 'Profile update failed'); }

            if (origUser && origUser.role !== role) {
                const roleRes = await fetch('/api/users/' + id + '/role', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ role })
                });
                if (!roleRes.ok) { const d = await roleRes.json(); throw new Error(d.message || 'Role update failed'); }
            }

            if (origUser && (origUser.status || 'active') !== status) {
                const statusRes = await fetch('/api/users/' + id + '/status', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ status })
                });
                if (!statusRes.ok) { const d = await statusRes.json(); throw new Error(d.message || 'Status update failed'); }
            }

            window.location.reload();
        } catch (err) {
            errMsg.textContent = err.message;
            errDiv.style.display = 'block';
            saveBtn.textContent = 'Save Account'; saveBtn.disabled = false;
        }
    }

    window.openDeleteModal = function(id, name) {
        deletingId = id;
        document.getElementById('deleteUserName').textContent = name;
        openModal('deleteModal');
    };

    async function deleteUser() {
        if (!deletingId) return;
        try {
            const res = await fetch('/api/users/' + deletingId, {
                method: 'DELETE',
                credentials: 'include'
            });
            if (res.ok || res.status === 204) {
                window.location.reload();
            } else {
                const d = await res.json();
                alert(d.message || 'Delete failed');
            }
        } catch (err) {
            alert('An error occurred: ' + err.message);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateStats();
        displayUsers();

        document.getElementById('saveUserBtn').onclick  = saveUser;
        document.getElementById('closeModalBtn').onclick = () => closeModal('userModal');
        document.getElementById('cancelModalBtn').onclick = () => closeModal('userModal');
        document.getElementById('cancelDeleteBtn').onclick = () => closeModal('deleteModal');
        document.getElementById('confirmDeleteBtn').onclick = deleteUser;

        document.getElementById('searchInput').addEventListener('input', displayUsers);
        document.getElementById('roleFilter').addEventListener('change', displayUsers);
        document.getElementById('statusFilter').addEventListener('change', displayUsers);
    });

</script>
<script src="/js/global.js"></script>
<script src="/js/admin-theme.js"></script>
</body>
</html>
