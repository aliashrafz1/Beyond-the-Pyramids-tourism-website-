<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Details - Beyond the Pyramids</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/userDashboard.css">
    <link rel="stylesheet" href="/css/bookingDetails.css">
</head>

<body>
    <div class="noise-overlay"></div>

    <div class="dashboard-shell">

        <aside class="dashboard-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <a href="/"><img src="/images/WebsiteBanner.png" alt="Beyond the Pyramids"></a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <span class="group-label">Discovery</span>
                    <ul>
                        <li><a href="/"><i class="fas fa-home"></i> Home Sanctuary</a></li>
                        <li><a href="/packages/day"><i class="fas fa-sun"></i> Day Packages</a></li>
                        <li><a href="/packages/week"><i class="fas fa-calendar-week"></i> Week Packages</a></li>
                        <li><a href="/packages/single"><i class="fas fa-location-dot"></i> Single Locations</a></li>
                        <li><a href="/custom-trip"><i class="fas fa-compass"></i> Trip Architect</a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label">Personal Desk</span>
                    <ul>
                        <li><a href="/dashboard"><i class="fas fa-columns"></i> Dashboard</a></li>
                        <li class="active"><a href="/my-bookings"><i class="fas fa-suitcase-rolling"></i> My Journeys</a></li>
                        <li><a href="/profile"><i class="fas fa-user-circle"></i> Profile Settings</a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label">Concierge</span>
                    <ul>
                        <li><a href="/faq"><i class="fas fa-question-circle"></i> Help &amp; FAQ</a></li>
                        <li><a href="/contact"><i class="fas fa-envelope"></i> Contact Us</a></li>
                        <li><a href="/reviews/write"><i class="fas fa-star"></i> Reviews</a></li>
                    </ul>
                </div>
            </nav>

            <div class="sidebar-footer">
                <button id="theme-toggle" class="theme-toggle-btn">
                    <i class="fas fa-moon"></i> <span>Dark Mode</span>
                </button>
                <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </div>
        </aside>

        <main class="dashboard-main">

            <header class="dash-topbar" id="dash-topbar">
                <div class="topbar-left">
                    <div class="greeting-stack">
                        <span class="greeting-label">Journey Details</span>
                        <h1 class="greeting-name">Booking Receipt</h1>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="topbar-avatar" id="user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            </header>

            <div class="dash-scroll-area">
                <div class="editorial-booking-container">

                    <div class="editorial-booking-main">
                        <header class="booking-header reveal-up">
                            <h2 class="editorial-title">Your <br/> <span class="text-gold">Itinerary</span></h2>
                            <p class="editorial-subtitle">A curated timeline of your upcoming Egyptian odyssey.</p>
                        </header>

                        <section class="editorial-card reveal-up">
                            <h3 class="card-title">Trip Information</h3>
                            <div class="info-group">
                                <div class="info-row">
                                    <span class="label">Package</span>
                                    <span class="value"><%= booking.packageName %></span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Travel Date</span>
                                    <span class="value"><%= booking.date || 'To be confirmed' %></span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Travelers</span>
                                    <span class="value"><%= booking.travelers %> Traveler<%= booking.travelers > 1 ? 's' : '' %> (<%= booking.tier || 'Standard' %>)</span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Primary Guest</span>
                                    <span class="value"><%= booking.userId ? booking.userId.name : user.name %></span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Status</span>
                                    <span class="value" style="color:<%= booking.status === 'confirmed' ? 'var(--color-success)' : booking.status === 'cancelled' ? 'var(--color-danger)' : 'var(--color-warning)' %>;text-transform:capitalize;font-weight:600;">
                                        <%= booking.status %>
                                    </span>
                                </div>
                                <div class="info-row">
                                    <span class="label">Payment</span>
                                    <span class="value" style="color:<%= booking.paymentStatus === 'paid' ? 'var(--color-success)' : 'var(--color-warning)' %>;text-transform:capitalize;font-weight:600;">
                                        <%= booking.paymentStatus %>
                                    </span>
                                </div>
                            </div>
                        </section>

                        <% if (booking.additionalTravelers && booking.additionalTravelers.length > 0) { %>
                        <section class="editorial-card reveal-up">
                            <h3 class="card-title">Additional Travelers</h3>
                            <ul class="itinerary-list">
                                <% booking.additionalTravelers.forEach((t, i) => { %>
                                <li><strong><%= i+2 %>.</strong> <%= t.firstName %> <%= t.lastName %> — <%= t.nationality %></li>
                                <% }) %>
                            </ul>
                        </section>
                        <% } %>

                        <section class="editorial-card reveal-up">
                            <h4 class="editorial-card__heading">Cancellation Policy</h4>
                            <p><strong>Free Cancellation:</strong> You can cancel for a full refund up to 48 hours before your travel date.</p>
                            <p><strong>Partial Refund:</strong> Cancellations made within 48 hours prior to departure will incur a 50% cancellation fee.</p>
                            <p><strong>Non-Refundable:</strong> No-shows are strictly non-refundable.</p>
                        </section>
                    </div>

                    <aside class="editorial-booking-sidebar reveal-up">
                        <div class="voucher-ticket">
                            <div class="ticket-header">
                                <div class="ticket-logo">Beyond the Pyramids</div>
                                <div class="ticket-status" id="trip-status" data-status="<%= booking.status %>"><%= booking.status.toUpperCase() %></div>
                            </div>

                            <div class="ticket-body">
                                <div class="ticket-ref">
                                    <span class="ref-label">Confirmation ID</span>
                                    <h3 class="ref-code"><%= booking.bookingNumber %></h3>
                                </div>

                                <div class="receipt-body">
                                    <div class="receipt-line">
                                        <span>Base Price</span>
                                        <span>EGP <%= (booking.basePrice || Math.round(booking.totalPrice / booking.travelers)).toLocaleString() %></span>
                                    </div>
                                    <div class="receipt-line">
                                        <span>Travelers</span>
                                        <span>&times; <%= booking.travelers %></span>
                                    </div>
                                    <hr class="receipt-divider">
                                    <div class="receipt-line total-line">
                                        <span>Total Paid</span>
                                        <span>EGP <%= booking.totalPrice.toLocaleString() %></span>
                                    </div>
                                    <p class="payment-method">Paid via Secure Wallet &bull; Egyptian Pound (EGP)</p>
                                </div>
                            </div>

                            <div class="ticket-barcode">
                                <div class="barcode-lines"></div>
                                <span class="barcode-number"><%= booking.bookingNumber %></span>
                            </div>

                            <div class="ticket-actions">
                                <button id="print-btn" class="btn btn--outline btn--small"><i class="fas fa-print"></i> Print Voucher</button>
                                <button id="copy-btn" class="btn btn--primary btn--small"><i class="fas fa-copy"></i> Copy ID</button>
                            </div>
                        </div>

                        <div style="margin-top:1rem;display:flex;gap:0.8rem;flex-wrap:wrap;">
                            <a href="/my-bookings" class="btn btn--outline btn--small">My Journeys</a>
                            <a href="/packages/day" class="btn btn--primary btn--small">Book Again</a>
                        </div>
                    </aside>

                </div>
            </div>

        </main>
    </div>

    <script>
        const SERVER_DATA = {
            user: <%- JSON.stringify(user) %>,
            booking: <%- JSON.stringify(booking) %>
        };
        window.SERVER_USER = SERVER_DATA.user;

</script>
    <script src="/js/global.js"></script>
    <script src="/js/bookingDetails.js"></script>
</body>

</html>
