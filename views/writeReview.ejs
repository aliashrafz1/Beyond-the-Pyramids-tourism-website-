<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Reviews | Beyond the Pyramids</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/userDashboard.css">
    <link rel="stylesheet" href="/css/writeReview.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <div class="noise-overlay"></div>

    <div class="dashboard-shell">

        <aside class="dashboard-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <a href="/"><img src="/images/WebsiteBanner.png" alt="Beyond the Pyramids"></a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <span class="group-label">Discovery</span>
                    <ul>
                        <li><a href="/"><i class="fas fa-home"></i> Home Sanctuary</a></li>
                        <li><a href="/packages/day"><i class="fas fa-sun"></i> Day Packages</a></li>
                        <li><a href="/packages/week"><i class="fas fa-calendar-week"></i> Week Packages</a></li>
                        <li><a href="/packages/single"><i class="fas fa-location-dot"></i> Single Locations</a></li>
                        <li><a href="/custom-trip"><i class="fas fa-compass"></i> Trip Architect</a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label">Personal Desk</span>
                    <ul>
                        <li><a href="/dashboard"><i class="fas fa-columns"></i> Dashboard</a></li>
                        <li><a href="/my-bookings"><i class="fas fa-suitcase-rolling"></i> My Journeys</a></li>
                        <li><a href="/profile"><i class="fas fa-user-circle"></i> Profile Settings</a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label">Concierge</span>
                    <ul>
                        <li><a href="/faq"><i class="fas fa-question-circle"></i> Help &amp; FAQ</a></li>
                        <li><a href="/contact"><i class="fas fa-envelope"></i> Contact Us</a></li>
                        <li class="active"><a href="/reviews/write"><i class="fas fa-star"></i> Reviews</a></li>
                    </ul>
                </div>
            </nav>

            <div class="sidebar-footer">
                <button id="theme-toggle" class="theme-toggle-btn">
                    <i class="fas fa-moon"></i> <span>Dark Mode</span>
                </button>
                <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </div>
        </aside>

        <main class="dashboard-main">
            <header class="dash-topbar" id="dash-topbar">
                <div class="topbar-left">
                    <div class="greeting-stack">
                        <span class="greeting-label">Concierge Feedback</span>
                        <h1 class="greeting-name">Share Your Review</h1>
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="account-chip" style="display:flex;align-items:center;gap:10px;">
                        <div class="account-chip__avatar" id="reviewer-avatar">
                            <% if (user.image) { %>
                            <img src="<%= user.image %>" alt="<%= user.name %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover;">
                            <% } else { %>
                            <i class="fas fa-user"></i>
                            <% } %>
                        </div>
                        <div>
                            <span class="account-chip__label">Signed in as</span>
                            <strong class="account-chip__name"><%= user.name %></strong>
                        </div>
                    </div>
                </div>
            </header>

            <div class="dash-scroll-area">
                <section class="review-intro reveal-up">
                    <div>
                        <span class="greeting-label">Traveler Voice</span>
                        <h2>Keep the experience honest, useful, and beautifully specific.</h2>
                        <p>Select the package category you experienced, choose the exact package, then leave a focused review for future travelers.</p>
                    </div>
                </section>

                <div class="review-workflow-container">
                    <section class="review-panel reveal-up">
                        <div class="section-header">
                            <span class="step-label">Step 1</span>
                            <h2>Select Package</h2>
                        </div>
                        <div class="review-options-grid">
                            <label class="selection-tile">
                                <input type="radio" name="packageType" value="day">
                                <div class="tile-content">
                                    <i class="fas fa-sun"></i>
                                    <span>Day Package</span>
                                </div>
                            </label>
                            <label class="selection-tile">
                                <input type="radio" name="packageType" value="week">
                                <div class="tile-content">
                                    <i class="fas fa-calendar-week"></i>
                                    <span>Week Package</span>
                                </div>
                            </label>
                            <label class="selection-tile">
                                <input type="radio" name="packageType" value="single">
                                <div class="tile-content">
                                    <i class="fas fa-location-dot"></i>
                                    <span>Single Location</span>
                                </div>
                            </label>
                        </div>

                        <div class="select-dropdown-container reveal-up">
                            <label for="package-select">Specific <span id="package-label">package</span></label>
                            <div class="premium-select-wrapper">
                                <select id="package-select">
                                    <option value="">Choose a package type first</option>
                                </select>
                            </div>
                        </div>

                        <div style="margin-top:1rem;">
                            <label style="color:var(--color-text-muted);display:block;margin-bottom:0.5rem;">Review Title *</label>
                            <input type="text" id="review-title" placeholder="e.g. Unforgettable Experience" maxlength="100" style="width:100%;background:var(--color-surface-alt);border:1px solid var(--color-border);color:var(--color-text);padding:0.8rem;border-radius:var(--radius-sm);box-sizing:border-box;">
                        </div>
                    </section>

                    <section class="review-panel reveal-up">
                        <div class="section-header">
                            <span class="step-label">Step 2</span>
                            <h2>Rate Experience</h2>
                        </div>
                        <div class="rating-architecture">
                            <h3>Overall rating</h3>
                            <div class="stars-glamour">
                                <i class="far fa-star" data-rating="1"></i>
                                <i class="far fa-star" data-rating="2"></i>
                                <i class="far fa-star" data-rating="3"></i>
                                <i class="far fa-star" data-rating="4"></i>
                                <i class="far fa-star" data-rating="5"></i>
                            </div>
                        </div>

                        <div class="text-review-area">
                            <label for="review-text">Detailed review</label>
                            <textarea id="review-text" rows="6" placeholder="What stood out, what went smoothly, and what should improve?"></textarea>
                        </div>
                    </section>

                    <section class="review-panel reveal-up">
                        <div class="section-header">
                            <span class="step-label">Optional</span>
                            <h2>Add Photos</h2>
                        </div>
                        <div class="upload-area-glamour" id="upload-area">
                            <i class="fas fa-camera-retro"></i>
                            <p>Upload JPG or PNG photos</p>
                            <input type="file" id="photo-input" accept="image/jpeg, image/png" style="display:none;" multiple>
                        </div>
                        <div class="photo-preview-grid" id="photo-preview"></div>
                    </section>

                    <div class="submit-actions reveal-up">
                        <div id="form-feedback" class="form-feedback" aria-live="polite"></div>
                        <button id="submit-review" class="btn btn--primary btn--large">
                            <i class="fas fa-paper-plane"></i> Submit Review
                        </button>
                    </div>
                </div>

                <section class="review-panel reveal-up" style="margin-top:2rem;">
                    <div class="section-header">
                        <span class="step-label">Your History</span>
                        <h2>My Reviews</h2>
                    </div>
                    <div id="my-reviews-list"><p style="color:var(--color-text-muted);padding:1rem 0;">Loading your reviews…</p></div>
                </section>
            </div>
        </main>
    </div>

    <div id="success-modal" class="modal-glamour">
        <div class="modal-content glass-card reveal-up">
            <div class="success-icon"><i class="fas fa-check-circle"></i></div>
            <h2>Review Submitted</h2>
            <p>Your feedback has been added to your dashboard.</p>
            <button class="btn btn--primary" onclick="window.location.href='/dashboard'">Return to Dashboard</button>
        </div>
    </div>

    <script>
        const SERVER_DATA = {
            user: <%- JSON.stringify(user) %>,
            packages: <%- JSON.stringify(packages) %>
        };
        window.SERVER_USER = SERVER_DATA.user;
        window.SERVER_PACKAGES = SERVER_DATA.packages;

</script>
    <script src="/js/global.js"></script>
    <script src="/js/writeReview.js"></script>
</body>

</html>
