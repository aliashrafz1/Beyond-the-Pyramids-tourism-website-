<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Single Locations - Beyond the Pyramids</title>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/singlePackages.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="noise-overlay"></div>

    <div class="page-shell">

        <aside class="page-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <a href="/"><img src="/images/WebsiteLogo.png" alt="Beyond the Pyramids"></a>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <span class="group-label">Discovery</span>
                    <ul>
                        <li><a href="/"><i class="fas fa-home"></i> <span>Home Sanctuary</span></a></li>
                        <li><a href="/packages/day"><i class="fas fa-sun"></i> <span>Day Packages</span></a></li>
                        <li><a href="/packages/week"><i class="fas fa-calendar-week"></i> <span>Week Packages</span></a></li>
                        <li class="active"><a href="/packages/single"><i class="fas fa-location-dot"></i> <span>Single Locations</span></a></li>
                        <li><a href="/custom-trip"><i class="fas fa-compass"></i> <span>Trip Architect</span></a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label">Personal Desk</span>
                    <ul>
                        <li><a href="/dashboard"><i class="fas fa-columns"></i> <span>Dashboard</span></a></li>
                        <li><a href="/my-bookings"><i class="fas fa-suitcase-rolling"></i> <span>My Journeys</span></a></li>
                        <li><a href="/profile"><i class="fas fa-user-circle"></i> <span>Profile Settings</span></a></li>
                    </ul>
                </div>

                <div class="nav-group">
                    <span class="group-label">Concierge</span>
                    <ul>
                        <li><a href="/faq"><i class="fas fa-question-circle"></i> <span>Help &amp; FAQ</span></a></li>
                        <li><a href="/contact"><i class="fas fa-envelope"></i> <span>Contact Us</span></a></li>
                        <li><a href="/reviews/write"><i class="fas fa-star"></i> <span>Reviews</span></a></li>
                    </ul>
                </div>
            </nav>

            <div class="sidebar-footer">
                <button id="theme-toggle" class="theme-toggle-btn">
                    <i class="fas fa-moon"></i> <span>Dark Mode</span>
                </button>
                <% if (user) { %>
                <a href="#" id="logout-link" class="logout-link"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
                <% } else { %>
                <a href="/login" class="logout-link"><i class="fas fa-sign-in-alt"></i> <span>Login</span></a>
                <% } %>
            </div>
        </aside>

        <div class="page-content">

            <header class="main-header reveal-up">
                <h1 class="hero-title">Explore <span class="text-gold">Historical Locations</span></h1>
                <p class="hero-description">Discover individual monuments, temples, and museums across Egypt.</p>
                <% if (user) { %>
                <div class="account-chip" data-account-chip style="display:flex;align-items:center;gap:10px;margin-top:10px;">
                    <div class="account-chip__avatar" data-account-avatar><i class="fas fa-user"></i></div>
                    <div>
                        <span class="account-chip__label">Signed in as</span>
                        <strong class="account-chip__name" data-account-name><%= user.name %></strong>
                    </div>
                </div>
                <% } %>
            </header>

            <section class="packages-container" id="locationsContainer">

            </section>

            <footer class="main-footer reveal-up">
                <div class="container footer-grid">
                    <div class="footer-brand">
                        <h3 class="footer-logo">Beyond the Pyramids</h3>
                        <p>Curating the eternal legacy of Egypt since 2012.</p>
                    </div>
                    <nav class="footer-nav">
                        <div class="footer-group">
                            <h4>Explore</h4>
                            <ul>
                                <li><a href="/#destinations">Destinations</a></li>
                                <li><a href="/#packages">Tour Packages</a></li>
                                <li><a href="/custom-trip">Custom Trips</a></li>
                            </ul>
                        </div>
                        <div class="footer-group">
                            <h4>Company</h4>
                            <ul>
                                <li><a href="/about">Our Story</a></li>
                                <li><a href="/faq">Common Questions</a></li>
                            </ul>
                        </div>
                        <div class="footer-group">
                            <h4>Legal</h4>
                            <ul>
                                <li><a href="/terms">Terms of Service</a></li>
                            </ul>
                        </div>
                    </nav>
                </div>
                <div class="footer-bottom container">
                    <p>&copy; 2026 Beyond the Pyramids. All rights reserved.</p>
                    <div class="credit">Designed for the modern explorer.</div>
                </div>
            </footer>

        </div>
    </div>

    <script>
        const SERVER_DATA = {
            user: <%- JSON.stringify(user) %>,
            packages: <%- JSON.stringify(packages) %>
        };
        window.SERVER_PACKAGES = SERVER_DATA.packages;
        window.SERVER_USER = SERVER_DATA.user;

</script>
    <script src="/js/global.js"></script>
    <script src="/js/singlePackages.js"></script>
</body>

</html>
